{
  "entities": {
    "AccessRequest": {
      "title": "AccessRequest",
      "description": "Represents a user access request and approval state for the SESI-PE 2027 dashboard.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the requesting user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email address of the user.",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "description": "Display name from Google profile.",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL from Google profile.",
          "minLength": 0,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Approval state managed by the administrator.",
          "enum": ["pending", "approved", "rejected"]
        },
        "role": {
          "type": "string",
          "description": "User role within the application.",
          "enum": ["viewer", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the access request was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the access request was last updated."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "status",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup record indexed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Administrator Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Administrator email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the admin record was created."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "TeamBirthdayDoc": {
      "title": "TeamBirthdayDoc",
      "description": "Stores a team birthday celebrant entry for the Mural de Aniversariantes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the birthday entry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full name of the team member.",
          "minLength": 1,
          "maxLength": 120
        },
        "day": {
          "type": "integer",
          "description": "Day of birth (1..31)."
        },
        "month": {
          "type": "integer",
          "description": "Month of birth (1..12)."
        },
        "unitOrSector": {
          "type": "string",
          "description": "School unit or department.",
          "minLength": 0,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "description": "Congratulatory message.",
          "minLength": 0,
          "maxLength": 300
        },
        "photoDataUrl": {
          "type": "string",
          "description": "Compressed square portrait data URL.",
          "minLength": 0,
          "maxLength": 350000
        },
        "avatarGradient": {
          "type": "string",
          "description": "Fallback gradient class.",
          "minLength": 0,
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "id",
        "name",
        "day",
        "month",
        "unitOrSector",
        "message",
        "photoDataUrl",
        "avatarGradient",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/accessRequests/{userId}": {
      "schema": {
        "$ref": "#/entities/AccessRequest"
      },
      "description": "Stores user login access requests and approval statuses."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Stores trusted administrator UIDs for role verification."
    },
    "/teamBirthdays/{memberId}": {
      "schema": {
        "$ref": "#/entities/TeamBirthdayDoc"
      },
      "description": "Stores team birthday mural entries synced across Vercel and TV mode."
    }
  }
}

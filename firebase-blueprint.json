{
  "entities": {
    "AccessRequest": {
      "title": "AccessRequest",
      "description": "Represents a user access request and approval state for the SESI-PE 2027 dashboard.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the requesting user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email address of the user.",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "description": "Display name from Google profile.",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL from Google profile.",
          "minLength": 0,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Approval state managed by the administrator.",
          "enum": ["pending", "approved", "rejected"]
        },
        "role": {
          "type": "string",
          "description": "User role within the application.",
          "enum": ["viewer", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the access request was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the access request was last updated."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "status",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup record indexed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Administrator Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Administrator email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the admin record was created."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "TeamBirthdayDoc": {
      "title": "TeamBirthdayDoc",
      "description": "Stores a team birthday celebrant entry for the Mural de Aniversariantes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the birthday entry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full name of the team member.",
          "minLength": 1,
          "maxLength": 120
        },
        "day": {
          "type": "integer",
          "description": "Day of birth (1..31)."
        },
        "month": {
          "type": "integer",
          "description": "Month of birth (1..12)."
        },
        "unitOrSector": {
          "type": "string",
          "description": "School unit or department.",
          "minLength": 0,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "description": "Congratulatory message.",
          "minLength": 0,
          "maxLength": 300
        },
        "photoDataUrl": {
          "type": "string",
          "description": "Compressed square portrait data URL.",
          "minLength": 0,
          "maxLength": 350000
        },
        "avatarGradient": {
          "type": "string",
          "description": "Fallback gradient class.",
          "minLength": 0,
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "id",
        "name",
        "day",
        "month",
        "unitOrSector",
        "message",
        "photoDataUrl",
        "avatarGradient",
        "updatedAt"
      ]
    },
    "TeamScheduleDoc": {
      "title": "TeamScheduleDoc",
      "description": "Stores a monthly schedule entry or current whereabouts for a collaborator.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the schedule entry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberId": {
          "type": "string",
          "description": "Collaborator ID from the team list.",
          "minLength": 1,
          "maxLength": 128
        },
        "memberName": {
          "type": "string",
          "description": "Collaborator full name.",
          "minLength": 1,
          "maxLength": 120
        },
        "day": {
          "type": "integer",
          "description": "Day of month (1..31)."
        },
        "endDay": {
          "type": "integer",
          "description": "Optional end day of month (1..31)."
        },
        "month": {
          "type": "integer",
          "description": "Month of year (1..12)."
        },
        "shift": {
          "type": "string",
          "description": "Shift or time range (e.g. Manhã, Tarde, Dia Todo).",
          "minLength": 1,
          "maxLength": 60
        },
        "locationCategory": {
          "type": "string",
          "description": "Category of location (sede, escola, evento, home_office, viagem, ferias).",
          "minLength": 1,
          "maxLength": 40
        },
        "locationName": {
          "type": "string",
          "description": "Specific school unit, sector or external venue.",
          "minLength": 1,
          "maxLength": 140
        },
        "activity": {
          "type": "string",
          "description": "Description of the activity or mission.",
          "minLength": 0,
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "id",
        "memberId",
        "memberName",
        "day",
        "endDay",
        "month",
        "shift",
        "locationCategory",
        "locationName",
        "activity",
        "updatedAt"
      ]
    },
    "TeamEventDoc": {
      "title": "TeamEventDoc",
      "description": "Stores a monthly team or school event, including photos of past events for the TV carousel.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the event.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Title of the event.",
          "minLength": 1,
          "maxLength": 140
        },
        "day": {
          "type": "integer",
          "description": "Start day of month (1..31)."
        },
        "endDay": {
          "type": "integer",
          "description": "End day of month (1..31)."
        },
        "month": {
          "type": "integer",
          "description": "Month of year (1..12)."
        },
        "timeRange": {
          "type": "string",
          "description": "Event time or schedule.",
          "minLength": 0,
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "description": "Unit or venue of the event.",
          "minLength": 1,
          "maxLength": 140
        },
        "status": {
          "type": "string",
          "description": "Event status: upcoming, today, or past.",
          "enum": ["upcoming", "today", "past"]
        },
        "description": {
          "type": "string",
          "description": "Summary or highlights of the event.",
          "minLength": 0,
          "maxLength": 400
        },
        "coverPhotoDataUrl": {
          "type": "string",
          "description": "Primary event photo data URL.",
          "minLength": 0,
          "maxLength": 350000
        },
        "extraPhotoDataUrl1": {
          "type": "string",
          "description": "Additional past event photo 1.",
          "minLength": 0,
          "maxLength": 350000
        },
        "extraPhotoDataUrl2": {
          "type": "string",
          "description": "Additional past event photo 2.",
          "minLength": 0,
          "maxLength": 350000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "id",
        "title",
        "day",
        "endDay",
        "month",
        "timeRange",
        "location",
        "status",
        "description",
        "coverPhotoDataUrl",
        "extraPhotoDataUrl1",
        "extraPhotoDataUrl2",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/accessRequests/{userId}": {
      "schema": {
        "$ref": "#/entities/AccessRequest"
      },
      "description": "Stores user login access requests and approval statuses."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Stores trusted administrator UIDs for role verification."
    },
    "/teamBirthdays/{memberId}": {
      "schema": {
        "$ref": "#/entities/TeamBirthdayDoc"
      },
      "description": "Stores team birthday mural entries synced across Vercel and TV mode."
    },
    "/teamSchedules/{scheduleId}": {
      "schema": {
        "$ref": "#/entities/TeamScheduleDoc"
      },
      "description": "Stores collaborator monthly schedules and current whereabouts for the TV carousel."
    },
    "/teamEvents/{eventId}": {
      "schema": {
        "$ref": "#/entities/TeamEventDoc"
      },
      "description": "Stores monthly events and past event photo galleries for the TV carousel."
    }
  }
}
